# XC Ski Labs (static site on SiteGround). Deployed by scripts/deploy.py --sync-errors.
# http -> https is enforced by SiteGround itself, before this file.

# One hostname: www.xcskilabs.com goes to xcskilabs.com with the same path.
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.xcskilabs\.com$ [NC]
RewriteRule ^ https://xcskilabs.com%{REQUEST_URI} [R=301,L]

# Branded not-found page (wordpress/generate_404.py).
ErrorDocument 404 /404.html

# Duplicate profiles removed 2026-11-15 (#87): send old URLs to the surviving race.
RewriteRule ^race/gatineau-55\.md$ https://xcskilabs.com/race/gatineau-loppet.md [R=301,L]
RewriteRule ^race/gatineau-55(?:/(.*))?$ https://xcskilabs.com/race/gatineau-loppet/$1 [R=301,L]
RewriteRule ^race/ushuaia-ski-marathon\.md$ https://xcskilabs.com/race/ushuaia-loppet.md [R=301,L]
RewriteRule ^race/ushuaia-ski-marathon(?:/(.*))?$ https://xcskilabs.com/race/ushuaia-loppet/$1 [R=301,L]

# Custom plan manage page (cancel, refund, next race). The training-plan
# pipeline serves it on Railway; Stripe checkout terms and plan emails link
# riders here. The page reads its #t= token from the URL fragment, which
# browsers keep across a redirect, and posts to relative /api/race-plan/*
# paths, so it can't be copied to this site. 302: the Railway address may
# change and a 301 is cached.
RewriteRule ^plan/manage/?$ https://athlete-custom-training-plan-pipeline-production.up.railway.app/plan/manage [R=302,L]
